// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AirlineUserRole {
  ADMIN
}

enum AirlineStaffRole {
  STAFF
}

model TRAVELER {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AIRLINE {
  id            String          @id @default(uuid())
  airlineName   String
  contactEmail  String          @unique
  iataCode      String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  users         AIRLINE_USER[]
  staff         AIRLINE_STAFF[]
  flights  Flight[]
  bookings Booking[]
}

model AIRLINE_USER {
  id           String          @id @default(uuid())
  airlineId    String
  email        String          @unique
  passwordHash String
  role         AirlineUserRole @default(ADMIN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  airline      AIRLINE         @relation(fields: [airlineId], references: [id], onDelete: Cascade)
}

model AIRLINE_STAFF {
  id           String           @id @default(uuid())
  airlineId    String
  email        String           @unique
  passwordHash String
  fullName     String
  role         AirlineStaffRole @default(STAFF)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  bookings Booking[]

  airline      AIRLINE          @relation(fields: [airlineId], references: [id], onDelete: Cascade)
}


enum FlightStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Flight {
  id             String       @id @default(uuid())
  airlineId      String
  flightNumber   String
  origin         String
  destination    String
  departureAt    DateTime
  arrivalAt      DateTime
  price          Float
  totalSeats     Int
  availableSeats Int
  status         FlightStatus @default(SCHEDULED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  airline        AIRLINE      @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  bookings       Booking[]

  @@unique([airlineId, flightNumber, departureAt])
  @@index([airlineId, status, departureAt])
}

model Booking {
  id                String        @id @default(uuid())
  bookingReference  String        @unique @default(uuid())
  airlineId         String
  flightId          String
  bookedByStaffId   String
  passengerFullName String
  passengerEmail    String
  passengerPhone    String
  seatCount         Int           @default(1)
  totalPrice        Float
  status            BookingStatus @default(CONFIRMED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  airline           AIRLINE       @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  flight            Flight        @relation(fields: [flightId], references: [id], onDelete: Restrict)
  bookedByStaff     AIRLINE_STAFF @relation(fields: [bookedByStaffId], references: [id], onDelete: Restrict)

  @@index([airlineId, createdAt])
  @@index([flightId, status])
  @@index([bookedByStaffId])
}
